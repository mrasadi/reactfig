{
  "name": "@reactfig/figma-plugin",
  "version": "0.1.0",
  "description": "Installable Figma plugin: imports a .rfd artifact and renders it as native, editable Figma nodes.",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "node build.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.code.json && tsc -p tsconfig.ui.json"
  },
  "dependencies": {
    "@reactfig/core": "workspace:*",
    "@reactfig/artifact": "workspace:*",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.94.0",
    "esbuild": "^0.23.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/node": "^22.0.0"
  }
}
