{
  "name": "@reactfig/mcp",
  "version": "0.1.0",
  "description": "MCP server exposing ReactFig's inspection/analysis/export pipeline to MCP-compatible agents (Claude Code, OpenCode, etc).",
  "license": "MIT",
  "type": "module",
  "bin": { "reactfig-mcp": "./dist/server.js" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@reactfig/core": "workspace:*",
    "@reactfig/model": "workspace:*",
    "@reactfig/analyzer": "workspace:*",
    "@reactfig/artifact": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.23.0",
    "playwright": "^1.46.0"
  },
  "devDependencies": { "typescript": "^5.5.0", "vitest": "^2.0.0", "@types/node": "^22.0.0" }
}
